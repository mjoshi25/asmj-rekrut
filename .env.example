# Local/dev defaults
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# MongoDB Atlas for test/prod profiles (replace with your own URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/asmj_recruitment?retryWrites=true&w=majority

# Cloudinary storage for candidate photos, joining documents and offer letters (required for these uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional SMTP email delivery for interview invitations and interview links
ASMJ_MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=notifications@your-domain.example
SMTP_AUTH=true
SMTP_STARTTLS=true

# Optional legacy local path: only needed to download files uploaded before Cloudinary storage was enabled.
ASMJ_UPLOAD_DIR=/var/data/private-uploads
