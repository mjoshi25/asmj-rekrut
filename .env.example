# Local/dev defaults
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# MongoDB Atlas for test/prod profiles (replace with your own URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/asmj_recruitment?retryWrites=true&w=majority

# Cloudinary photo uploads (required to enable candidate photo upload)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
